{
	"name": "linked-canvas",
	"version": "0.5.9",
	"description": "Turn Markdown links into a living Canvas while preserving every Vault file as the source of truth.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck --noUnusedLocals --noUnusedParameters",
		"check:css": "node scripts/check-css.mjs",
		"check:media": "node scripts/check-release-media.mjs",
		"build": "npm run typecheck && npm run check:css && npm run check:media && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "tsx --test tests/*.test.ts",
		"check": "npm run lint && npm run build && npm test"
	},
	"keywords": [
		"obsidian",
		"canvas",
		"markdown",
		"whiteboard",
		"knowledge-management",
		"knowledge-graph"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/woonyong-kr/linked-canvas.git"
	},
	"bugs": {
		"url": "https://github.com/woonyong-kr/linked-canvas/issues"
	},
	"homepage": "https://github.com/woonyong-kr/linked-canvas#readme",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/d3-force": "^3.0.6",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"d3-force": "^3.0.0"
	}
}
