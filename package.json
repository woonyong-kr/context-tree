{
	"name": "linked-graph",
	"version": "1.0.1",
	"description": "A focused current-note link navigator for Obsidian's right sidebar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck --noUnusedLocals --noUnusedParameters",
		"check:css": "node scripts/check-css.mjs",
		"check:media": "node scripts/check-release-media.mjs",
		"build": "npm run typecheck && npm run check:css && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test tests/*.test.ts",
		"check": "npm run lint && npm run build && npm test && npm run check:media"
	},
	"keywords": [
		"obsidian",
		"markdown",
		"navigation",
		"sidebar",
		"knowledge-management",
		"knowledge-graph"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/woonyong-kr/linked-graph.git"
	},
	"bugs": {
		"url": "https://github.com/woonyong-kr/linked-graph/issues"
	},
	"homepage": "https://github.com/woonyong-kr/linked-graph#readme",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
